// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/cpp
{
	"name": "C++",
	"build": {
		"dockerfile": "Dockerfile"
	},

	// Affichage des fenêtres sur Windows 11 : serveur X11 de WSLg partagé par Docker Desktop
	"mounts": [
		"source=/run/desktop/mnt/host/wslg/.X11-unix,target=/tmp/.X11-unix,type=bind"
	],

	// Transmettre la variable d'affichage
	"containerEnv": {
		"DISPLAY": ":0"
	},

	// Permet de joindre Ollama qui tourne sur Windows (host.docker.internal:11434)
	"runArgs": [
		"--add-host=host.docker.internal:host-gateway"
	]
}
